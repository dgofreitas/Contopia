# Contopia - variáveis de ambiente
# Copie para .env e preencha. Nunca faça commit do .env.

NODE_ENV=development

# MongoDB
MONGODB_DATABASE=contopia
# Só em produção (docker-compose.prod.yml): usuário root do Mongo
MONGO_INITDB_ROOT_USERNAME=contopia
MONGO_INITDB_ROOT_PASSWORD=troque-esta-senha

# Redis (só em produção)
REDIS_PASSWORD=troque-esta-senha

# JWT - gere com: openssl rand -base64 64
JWT_SECRET=troque-por-um-segredo-longo
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d

# URL pública do site
FRONTEND_URL=http://localhost:8089
# Produção: FRONTEND_URL=https://contopia.duckdns.org

# Deploy (servidor)
DOMAIN=contopia.duckdns.org
IMAGE_TAG=latest
# Rede Docker onde roda o Caddy que termina o HTTPS (o do moneyTrackr)
EDGE_NETWORK=moneytrackr_frontend
