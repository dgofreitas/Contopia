# Estante Digital — Environment Variables
# Copy this file to .env and fill in values

# === JWT Configuration (NFR-SEC-03) ===
JWT_SECRET=change-me-to-a-64-char-random-string-here-immediately-now
JWT_EXPIRY=30m
JWT_REFRESH_EXPIRY=7d
BCRYPT_ROUNDS=12

# === MongoDB ===
MONGODB_URI=mongodb://mongodb:27017/estantedigital
MONGODB_DB_NAME=estantedigital
MONGO_ROOT_USER=estantedigital
MONGO_ROOT_PASSWORD=changeme

# === Redis ===
REDIS_URL=redis://redis:6379

# === Cloudflare R2 (S3-compatible) (NFR-SEC-02, NFR-SCL-04) ===
R2_ENDPOINT=https://xxxxxxxxxxxx.r2.cloudflarestorage.com
R2_ACCESS_KEY=your-r2-access-key
R2_SECRET_KEY=your-r2-secret-key
R2_BUCKET=estantedigital-assets
R2_REGION=auto

# === Email (Parent verification) ===
PARENT_EMAIL_FROM=noreply@estantedigital.example
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# === App ===
NODE_ENV=development
PORT=8000
LOG_LEVEL=info

# === Rate Limiting (NFR-SEC-06) ===
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100

# === Frontend build-time (used in Dockerfile --build-arg) ===
VITE_API_URL=http://localhost:8088/api
